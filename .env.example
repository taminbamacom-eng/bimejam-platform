# ==============================================================================
# بیمه جم (Bimeh Jam) - تنظیمات متغیرهای محیطی (Environment Variables)
# ==============================================================================
# برای استفاده در سرور، این فایل را به .env کپی کنید: cp .env.example .env
# و مقادیر مورد نظر خود را وارد فرمایید.

# ------------------------------------------------------------------------------
# 1. تنظیمات سرور و محیط اجرا (Server & Environment Configuration)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. پایگاه داده اس‌کیو‌لایت (SQLite Database via Prisma)
# ------------------------------------------------------------------------------
# آدرس فایل دیتابیس درون کانتینر یا سیستم لوکال
DATABASE_URL="file:/app/prisma/dev.db"

# ------------------------------------------------------------------------------
# 3. کلید امنیتی احراز هویت و حساب‌های اولیه (Authentication & Initial Accounts)
# ------------------------------------------------------------------------------
# یک رشته تصادفی و امن طولانی برای امضای توکن‌های JWT مدیران و کارشناسان
JWT_SECRET="your_very_secure_random_jwt_secret_key_change_in_production"

# ایمیل و گذرواژه اولیه جهت ساخت کاربر ادمین در اولین اجرای دیتابیس
ADMIN_INITIAL_EMAIL="admin@bimehjam.ir"
ADMIN_INITIAL_PASSWORD="your_strong_admin_password_here"
OPERATOR_INITIAL_PASSWORD="your_strong_operator_password_here"

# ------------------------------------------------------------------------------
# 4. سرویس هوش مصنوعی گوگل جیمنای (Google Gemini AI API Key)
# ------------------------------------------------------------------------------
# دریافت از Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 5. سرویس هوش مصنوعی اوپن‌ای‌آی (OpenAI GPT-4o / GPT-5 API Key) - اختیاری
# ------------------------------------------------------------------------------
# دریافت از OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. سرویس چت آنلاین و وب‌هوک گفتینو (Goftino Chat & Webhook Integration)
# ------------------------------------------------------------------------------
# دریافت از پنل مدیریت گفتینو > منوی برنامه‌نویسان و API
GOFTINO_API_KEY="your_goftino_api_key_here"

# شناسه اپراتور هوش مصنوعی در پنل گفتینو (اختیاری)
GOFTINO_OPERATOR_ID=""

